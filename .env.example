# ============================================================================
# TERAPLAYZ configuration. Copy to .env for local use; on Koyeb set these as
# Service environment variables (use Koyeb *Secrets* for anything sensitive).
# Never commit a real .env.
# ============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=production                 # production | development | test
PORT=3000                           # Koyeb routes to this port
PUBLIC_BASE_URL=https://teraplayz-yourorg.koyeb.app   # public https URL, no trailing slash (webhook + bot links)
TRUST_PROXY=1                       # hops of reverse proxies in front of the app (Koyeb edge = 1)
COOKIE_SECURE=true                  # defaults to true in production (requires HTTPS)

# --- Secrets -----------------------------------------------------------------
# 32+ random chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_TTL_DAYS=30

# Admin account upserted on every start (password is re-hashed with bcrypt;
# changing it here rotates it and signs out the admin's old sessions).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=use-a-long-unique-password

# --- Database ----------------------------------------------------------------
# Set DATABASE_URL to use PostgreSQL (Neon, Koyeb Postgres, Supabase, …).
# REQUIRED on the Koyeb free instance: it has no persistent disk/volumes,
# so a SQLite file would be wiped on every restart/redeploy.
DATABASE_URL=
DATABASE_SSL=auto                   # auto (SSL for non-localhost) | require | disable
PG_POOL_MAX=4                       # small pool for 0.1 vCPU / 512 MB
# Without DATABASE_URL, SQLite is used (good for local dev or a paid instance with a volume):
DATA_DIR=./data                     # SQLite file + disk thumbnails
DATABASE_PATH=                      # default: $DATA_DIR/teraplayz.db

# --- Telegram (official Bot API) --------------------------------------------
# Leave TELEGRAM_BOT_TOKEN empty to run in DEMO mode (Creative Commons sample films,
# payments disabled).
TELEGRAM_BOT_TOKEN=                 # from @BotFather — keep secret
TELEGRAM_BOT_USERNAME=              # optional, e.g. TeraplayzBot (otherwise fetched via getMe)
TELEGRAM_CHANNEL_ID=                # private channel numeric id, e.g. -1001234567890 — keep secret
TELEGRAM_WEBHOOK_SECRET=            # 16–256 chars [A-Za-z0-9_-]; sent by Telegram in X-Telegram-Bot-Api-Secret-Token
TELEGRAM_API_ROOT=https://api.telegram.org   # point to a self-hosted Bot API server to lift the 20 MB limit
TELEGRAM_MAX_FILE_MB=               # default 20 for api.telegram.org, 2000 for a self-hosted server
TELEGRAM_AUTO_INGEST=true           # create draft videos from new channel posts

# --- Premium (Telegram Stars, currency XTR) ---------------------------------
PREMIUM_PRICE_STARS=100
PREMIUM_PERIOD_DAYS=31              # one "month" = 31 days, stacked from the current expiry
PREMIUM_TITLE=TERAPLAYZ Premium — 1 month
PREMIUM_DESCRIPTION=Ad-free streaming, premium-only catalogue and a Premium badge for 31 days.

# --- Content / UX --------------------------------------------------------------
SEED_DEMO=                          # empty = auto (seed CC demo films only in demo mode on an empty DB); true | false
SUPPORT_CONTACT=                    # shown by the bot's /paysupport command (email or @username)
ALLOW_REGISTRATION=true
PREMIUM_TEASERS=true                # show premium titles as locked cards to free users (false = hide them)
PAGE_SIZE=24
CACHE_TTL_SECONDS=60                # in-memory cache for public listings
MAX_THUMB_UPLOAD_MB=5
THUMB_STORAGE=                      # db | disk — default: db when DATABASE_URL is set, else disk
