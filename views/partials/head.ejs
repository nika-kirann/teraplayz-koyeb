<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= title %></title>
  <meta name="description" content="<%= description %>">
  <meta name="theme-color" content="#07030d">
  <meta name="color-scheme" content="dark">
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;700;800&family=Manrope:wght@400;500;600;700&display=swap">
  <link rel="stylesheet" href="/css/app.css?v=1">
  <% if (typeof admin !== 'undefined' && admin) { %><link rel="stylesheet" href="/css/admin.css?v=1"><% } %>
  <meta name="csrf-token" content="<%= csrfToken %>">
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
<a class="skip-link" href="#main">Skip to content</a>
<div class="bg-grid" aria-hidden="true"></div>
<header class="nav" id="top">
  <div class="nav-inner">
    <a href="/" class="nav-brand" aria-label="TERAPLAYZ home"><%- include('logo') %></a>
    <nav class="nav-links" aria-label="Primary">
      <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Home</a>
      <a href="/browse" class="<%= currentPath === '/browse' ? 'active' : '' %>">Browse</a>
      <div class="nav-dd">
        <button class="nav-dd-btn" type="button" aria-expanded="false" aria-haspopup="true">Categories <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></button>
        <div class="nav-dd-menu" role="menu">
          <% navCategories.forEach(function (c) { %>
            <a role="menuitem" href="/category/<%= c.slug %>"><%= c.name %><span><%= c.video_count %></span></a>
          <% }) %>
        </div>
      </div>
      <a href="/browse?premium=1" class="<%= query.premium === '1' ? 'active' : '' %>">Premium picks</a>
    </nav>
    <form class="nav-search" action="/search" method="get" role="search">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
      <input type="search" name="q" placeholder="Search films, shorts, nature…" aria-label="Search videos" value="<%= typeof q !== 'undefined' ? q : '' %>" maxlength="80" autocomplete="off" id="nav-search-input">
      <div class="search-suggest" id="search-suggest" role="listbox" hidden></div>
    </form>
    <div class="nav-actions">
      <% if (user) { %>
        <% if (user.isPremium) { %>
          <a href="/premium" class="badge-premium" title="Premium member"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.6 7.1.6-5.4 4.7 1.6 7L12 17.3 5.8 21l1.6-7L2 9.2l7.1-.6z"/></svg>Premium</a>
        <% } else { %>
          <a href="/premium" class="btn btn-glow btn-sm">Go Premium</a>
        <% } %>
        <div class="nav-dd nav-user">
          <button class="avatar nav-dd-btn" type="button" aria-expanded="false" aria-haspopup="true" aria-label="Account menu"><%= user.username.slice(0, 1).toUpperCase() %></button>
          <div class="nav-dd-menu right" role="menu">
            <div class="menu-head"><strong><%= user.username %></strong><small><%= user.isPremium ? 'Premium member' : 'Free plan' %></small></div>
            <a role="menuitem" href="/account">My account</a>
            <a role="menuitem" href="/premium">Membership</a>
            <% if (user.isAdmin) { %><a role="menuitem" href="/admin">Admin dashboard</a><% } %>
            <form action="/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" role="menuitem">Sign out</button></form>
          </div>
        </div>
      <% } else { %>
        <a href="/login" class="btn btn-ghost btn-sm">Sign in</a>
        <% if (cfg.allowRegistration) { %><a href="/register" class="btn btn-glow btn-sm hide-xs">Join free</a><% } %>
      <% } %>
      <button class="nav-burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu"><span></span><span></span><span></span></button>
    </div>
  </div>
  <div class="mobile-menu" id="mobile-menu" hidden>
    <a href="/">Home</a><a href="/browse">Browse</a><a href="/browse?premium=1">Premium picks</a>
    <div class="mobile-cats"><% navCategories.forEach(function (c) { %><a class="chip" href="/category/<%= c.slug %>"><%= c.name %></a><% }) %></div>
    <% if (!user) { %><a href="/login">Sign in</a><a href="/register">Create account</a><% } else { %><a href="/account">My account</a><% if (user.isAdmin) { %><a href="/admin">Admin</a><% } %><% } %>
  </div>
</header>
<% if (flash) { %>
  <div class="flash flash-<%= flash.type %>" role="status"><span><%= flash.msg %></span><button type="button" class="flash-x" aria-label="Dismiss">×</button></div>
<% } %>
<% if (user && user.isPremium && user.premium_auto_renew && Number(user.premium_until) - Date.now() < 3 * 864e5 && currentPath !== '/premium') { %>
  <div class="flash flash-warn" role="status"><span>Your Premium ends on <strong><%= h.formatDate(user.premium_until) %></strong>. <a href="/premium">Renew for <%= cfg.priceStars %> ⭐</a> to keep it ad-free.</span></div>
<% } %>
<main id="main">
