<%- include('../partials/admin-top') %>
<header class="admin-head">
  <div><h1>Videos</h1><p class="muted"><%= total %> total. Video files stay in Telegram; only metadata is stored here.</p></div>
  <a class="btn btn-glow btn-sm" href="/admin/videos/new">+ Add video</a>
</header>
<form class="filters" method="get" action="/admin/videos">
  <input type="search" name="q" value="<%= q %>" placeholder="Title or Telegram message id">
  <select name="status">
    <option value="">All</option>
    <option value="published" <%= status === 'published' ? 'selected' : '' %>>Published</option>
    <option value="draft" <%= status === 'draft' ? 'selected' : '' %>>Drafts / unpublished</option>
    <option value="premium" <%= status === 'premium' ? 'selected' : '' %>>Premium-only</option>
    <option value="oversized" <%= status === 'oversized' ? 'selected' : '' %>>Over Telegram limit</option>
  </select>
  <button class="btn btn-ghost btn-sm">Filter</button>
</form>
<div class="table-wrap">
<table class="table">
  <thead><tr><th>Video</th><th>Category</th><th>Source</th><th>Status</th><th>Views</th><th class="right">Actions</th></tr></thead>
  <tbody>
  <% items.forEach(function (v) { var over = v.source_type === 'telegram' && v.file_size > maxBytes; %>
    <tr data-video-row="<%= v.id %>">
      <td><div class="t-video"><img src="<%= v.thumb %>" alt="" loading="lazy" width="96" height="54"><div><a href="/admin/videos/<%= v.id %>/edit"><strong><%= v.title %></strong></a><small class="muted">/watch/<%= v.slug %> · updated <%= h.timeAgo(v.updated_at) %></small></div></div></td>
      <td><%= v.category_name || '—' %></td>
      <td><% if (v.source_type === 'telegram') { %><span class="pill">Telegram<%= v.telegram_message_id ? ' #' + v.telegram_message_id : '' %></span> <small class="muted"><%= h.formatBytes(v.file_size) %></small><% if (over) { %> <span class="pill pill-warn" title="Exceeds Bot API getFile limit">too large</span><% } %><% } else { %><span class="pill">Public URL</span><% } %></td>
      <td><span class="pill <%= v.is_published ? 'pill-ok' : 'pill-muted' %>" data-status><%= v.is_published ? 'Published' : 'Unpublished' %></span><% if (v.is_premium) { %> <span class="pill pill-premium">Premium</span><% } %><% if (v.is_featured) { %> <span class="pill">Featured</span><% } %><% if (v.download_allowed) { %> <span class="pill">DL</span><% } %></td>
      <td><%= h.formatCount(v.views) %></td>
      <td class="right actions">
        <a class="btn btn-ghost btn-xs" href="/watch/<%= v.slug %>">View</a>
        <a class="btn btn-ghost btn-xs" href="/admin/videos/<%= v.id %>/edit">Edit</a>
        <form method="post" action="/admin/videos/<%= v.id %>/<%= v.is_published ? 'unpublish' : 'publish' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-xs <%= v.is_published ? 'btn-ghost' : 'btn-glow' %>"><%= v.is_published ? 'Unpublish' : 'Publish' %></button></form>
        <form method="post" action="/admin/videos/<%= v.id %>/delete" data-confirm="Delete “<%= v.title %>”? The Telegram file is not touched."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-danger btn-xs">Delete</button></form>
      </td>
    </tr>
  <% }) %>
  <% if (!items.length) { %><tr><td colspan="6" class="empty-cell">No videos found. <a href="/admin/videos/new">Add one</a>.</td></tr><% } %>
  </tbody>
</table>
</div>
<% var base = { q: q, status: status }; %>
<%- include('../partials/pagination', { page: page, pages: pages, base: base }) %>
<%- include('../partials/admin-bottom') %>
