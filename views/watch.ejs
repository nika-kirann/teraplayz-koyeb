<%- include('partials/head', { bodyClass: 'page-watch' }) %>
<div class="container watch">
  <div class="watch-main">
    <% if (playable) { %>
    <div class="player" id="player" tabindex="-1"
         data-video-id="<%= video.id %>" data-resume="<%= resumeAt %>" data-logged-in="<%= user ? '1' : '0' %>" data-duration="<%= video.duration || 0 %>">
      <video id="video" class="player-video" preload="metadata" playsinline poster="<%= video.thumb %>" src="/stream/<%= video.id %>" <% if (!canDownload) { %>controlslist="nodownload"<% } %>></video>
      <div class="player-spinner" aria-hidden="true"><span></span></div>
      <button class="player-bigplay" type="button" aria-label="Play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></button>
      <div class="player-toast" role="status" aria-live="polite"></div>
      <div class="player-resume" hidden>
        <span>Resume from <b data-resume-label>0:00</b>?</span>
        <button type="button" class="btn btn-glow btn-sm" data-resume-yes>Resume</button>
        <button type="button" class="btn btn-ghost btn-sm" data-resume-no>Start over</button>
      </div>
      <div class="player-ui">
        <div class="player-progress" role="slider" tabindex="0" aria-label="Seek" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-valuetext="0:00">
          <div class="pp-buffer"></div><div class="pp-played"></div><div class="pp-thumb"></div><div class="pp-hover" hidden>0:00</div>
        </div>
        <div class="player-bar">
          <button class="pc pc-play" type="button" aria-label="Play (k)" data-act="play">
            <svg class="i-play" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            <svg class="i-pause" viewBox="0 0 24 24"><path d="M7 5h4v14H7zM13 5h4v14h-4z"/></svg>
          </button>
          <button class="pc" type="button" aria-label="Back 10 seconds (j)" data-act="back"><svg viewBox="0 0 24 24"><path d="M12 5V2L7 6l5 4V7a6 6 0 1 1-6 6H4a8 8 0 1 0 8-8z"/><text x="12" y="16.5" text-anchor="middle" font-size="7" font-weight="700" fill="currentColor" stroke="none">10</text></svg></button>
          <button class="pc" type="button" aria-label="Forward 10 seconds (l)" data-act="fwd"><svg viewBox="0 0 24 24"><path d="M12 5V2l5 4-5 4V7a6 6 0 1 0 6 6h2a8 8 0 1 1-8-8z"/><text x="12" y="16.5" text-anchor="middle" font-size="7" font-weight="700" fill="currentColor" stroke="none">10</text></svg></button>
          <div class="pc-vol">
            <button class="pc" type="button" aria-label="Mute (m)" data-act="mute">
              <svg class="i-vol" viewBox="0 0 24 24"><path d="M4 9v6h4l5 4V5L8 9zM16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="2"/><path d="M4 9v6h4l5 4V5L8 9z"/></svg>
              <svg class="i-mute" viewBox="0 0 24 24"><path d="M4 9v6h4l5 4V5L8 9z"/><path d="M16 9l5 6M21 9l-5 6" stroke="currentColor" stroke-width="2"/></svg>
            </button>
            <input class="pc-vol-range" type="range" min="0" max="1" step="0.05" value="1" aria-label="Volume">
          </div>
          <span class="pc-time"><span data-cur>0:00</span> / <span data-dur>0:00</span></span>
          <span class="pc-spacer"></span>
          <span class="pc-quality" data-quality hidden></span>
          <div class="pc-menu-wrap">
            <button class="pc pc-speed" type="button" aria-label="Playback speed" aria-haspopup="true" aria-expanded="false" data-act="speed"><span data-speed-label>1×</span></button>
            <div class="pc-menu" role="menu" hidden>
              <% [0.5, 0.75, 1, 1.25, 1.5, 1.75, 2].forEach(function (s) { %><button type="button" role="menuitemradio" aria-checked="<%= s === 1 %>" data-speed="<%= s %>"><%= s %>×</button><% }) %>
            </div>
          </div>
          <% if (canDownload) { %>
          <a class="pc" href="/download/<%= video.id %>" aria-label="Download" title="Download" download><svg viewBox="0 0 24 24"><path d="M12 3v12m0 0l-5-5m5 5l5-5M5 21h14" fill="none" stroke="currentColor" stroke-width="2"/></svg></a>
          <% } %>
          <button class="pc" type="button" aria-label="Picture in picture" data-act="pip" hidden><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><rect x="12" y="11" width="7" height="6" rx="1"/></svg></button>
          <button class="pc" type="button" aria-label="Fullscreen (f)" data-act="fs">
            <svg class="i-fs" viewBox="0 0 24 24"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" fill="none" stroke="currentColor" stroke-width="2"/></svg>
            <svg class="i-fs-exit" viewBox="0 0 24 24"><path d="M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5" fill="none" stroke="currentColor" stroke-width="2"/></svg>
          </button>
        </div>
      </div>
    </div>
    <% } else { %>
    <div class="player player-locked">
      <img src="<%= video.thumb %>" alt="" class="locked-bg">
      <div class="locked-card">
        <% if (!access.ok && (access.reason === 'premium' || access.reason === 'login_premium')) { %>
          <div class="locked-ico"><svg viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3" fill="none" stroke="currentColor" stroke-width="2"/></svg></div>
          <h2>Premium exclusive</h2>
          <p><%= access.reason === 'login_premium' ? 'Sign in and upgrade to Premium to watch this title.' : 'Upgrade to Premium to watch this title ad-free.' %></p>
          <div class="hero-cta">
            <% if (access.reason === 'login_premium') { %><a class="btn btn-ghost" href="/login?next=/watch/<%= video.slug %>">Sign in</a><% } %>
            <a class="btn btn-glow" href="/premium">Get Premium · <%= cfg.priceStars %> ⭐/month</a>
          </div>
        <% } else if (oversized) { %>
          <h2>Playback unavailable</h2>
          <p>This file is larger than the Telegram Bot API download limit.<% if (user && user.isAdmin) { %> <strong>Admin:</strong> re-encode it under the limit or configure a self-hosted Bot API server (TELEGRAM_API_ROOT).<% } %></p>
        <% } else { %>
          <h2>Playback unavailable</h2>
          <p><%= cfg.demoMode && video.source_type === 'telegram' ? 'Telegram playback is disabled while the site runs in demo mode.' : 'The video source is not ready yet. Please check back soon.' %></p>
        <% } %>
      </div>
    </div>
    <% } %>

    <%- include('partials/ad-slot', { slot: 'watch_below' }) %>

    <section class="watch-info">
      <div class="watch-title-row">
        <h1><%= video.title %></h1>
        <div class="watch-badges">
          <% if (video.is_premium) { %><span class="tag tag-premium">Premium</span><% } %>
          <% if (video.isHD) { %><span class="tag tag-hd"><%= video.height >= 2160 ? '4K' : video.height >= 1080 ? '1080p' : '720p' %></span><% } %>
          <% if (!video.is_published) { %><span class="tag tag-draft">Unpublished (admin preview)</span><% } %>
        </div>
      </div>
      <p class="watch-meta">
        <% if (video.category_name) { %><a href="/category/<%= video.category_slug %>" class="chip chip-sm"><%= video.category_name %></a><% } %>
        <span><%= h.formatCount(video.views) %> views</span><i>•</i>
        <time datetime="<%= new Date(Number(video.date)).toISOString() %>"><%= h.formatDate(video.date) %></time>
        <% if (video.duration) { %><i>•</i><span><%= h.formatDuration(video.duration) %></span><% } %>
      </p>
      <div class="watch-actions">
        <% if (canDownload) { %><a class="btn btn-ghost btn-sm" href="/download/<%= video.id %>" download>Download</a><% } else if (video.download_allowed && !user) { %><a class="btn btn-ghost btn-sm" href="/login?next=/watch/<%= video.slug %>">Sign in to download</a><% } %>
        <button class="btn btn-ghost btn-sm" type="button" data-share>Copy link</button>
        <% if (user && user.isAdmin) { %><a class="btn btn-ghost btn-sm" href="/admin/videos/<%= video.id %>/edit">Edit in admin</a><% } %>
      </div>
      <p class="watch-desc"><%= video.description %></p>
      <p class="muted small kbd-help">Shortcuts: <kbd>Space</kbd>/<kbd>K</kbd> play · <kbd>J</kbd>/<kbd>L</kbd> ±10s · <kbd>←</kbd>/<kbd>→</kbd> ±5s · <kbd>↑</kbd>/<kbd>↓</kbd> volume · <kbd>M</kbd> mute · <kbd>F</kbd> fullscreen · <kbd>&lt;</kbd>/<kbd>&gt;</kbd> speed</p>
    </section>
  </div>

  <aside class="watch-side">
    <%- include('partials/ad-slot', { slot: 'watch_sidebar' }) %>
    <h2 class="side-h">Up next</h2>
    <div class="side-list">
      <% related.forEach(function (r) { var locked = r.is_premium && !(user && (user.isPremium || user.isAdmin)); %>
        <a class="side-item" href="/watch/<%= r.slug %>">
          <span class="side-thumb"><img src="<%= r.thumb %>" alt="" loading="lazy" decoding="async" width="320" height="180"><% if (r.duration) { %><span class="card-dur"><%= h.formatDuration(r.duration) %></span><% } %><% if (locked) { %><span class="tag tag-premium mini">Premium</span><% } %></span>
          <span class="side-text"><strong><%= r.title %></strong><small><%= r.category_name || 'Video' %> · <%= h.formatCount(r.views) %> views</small></span>
        </a>
      <% }) %>
      <% if (!related.length) { %><p class="muted">More videos coming soon.</p><% } %>
    </div>
  </aside>
</div>
<%- include('partials/foot', { scripts: playable ? ['/js/player.js'] : [] }) %>
